# Required
TELEGRAM_BOT_TOKEN=replace_with_new_telegram_bot_token
GROUP_CHAT_ID=replace_with_telegram_chat_id

# Optional AI configuration (core news collection does not require AI)
GEMINI_API_KEY=replace_with_new_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# News collection and group publishing
NEWS_CHECK_INTERVAL_SECONDS=300
MAX_POSTS_PER_CHECK=12
MESSAGE_DELAY_SECONDS=2
MINIMUM_POST_SCORE=58
FETCH_WORKERS=8

# Private browsing / archive
PRIVATE_PAGE_SIZE=8
ARCHIVE_RETENTION_DAYS=90
USER_REQUEST_LIMIT=30
USER_REQUEST_WINDOW_SECONDS=300

# Recommended on Railway when a persistent volume is mounted at /data
NEWS_DB_PATH=/data/news_bot.sqlite3

# Optional: comma-separated Telegram user IDs allowed to use /health
ADMIN_USER_IDS=replace_with_admin_telegram_user_id
